{
	"name": "@earendil-works/pi-ext-fff",
	"version": "0.1.0",
	"description": "FFF-powered fuzzy file resolution, autocomplete, and content search extension for pie (vendored from pi-ext-fff)",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./index.ts",
			"import": "./index.ts"
		}
	},
	"files": [
		"index.ts",
		"src",
		"LICENSE"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json",
		"prepublishOnly": "npm run clean && npm run build",
		"typecheck": "tsgo -p tsconfig.build.json"
	},
	"keywords": [
		"pi-package",
		"pi",
		"coding-agent",
		"extension",
		"autocomplete",
		"files",
		"fff"
	],
	"license": "MIT",
	"dependencies": {
		"@ff-labs/fff-node": "0.9.6",
		"@sinclair/typebox": "0.34.52",
		"better-result": "2.10.0"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "^0.1.0",
		"@earendil-works/pi-tui": "^0.1.0"
	},
	"pi": {
		"extensions": [
			"./index.ts"
		],
		"image": "https://github.com/user-attachments/assets/c9020bb7-f708-4f75-a802-6ac182b48e07"
	}
}