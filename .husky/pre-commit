#!/bin/sh

STAGED_FILES=$(mktemp)
trap 'rm -f "$STAGED_FILES"' EXIT HUP INT TERM
git diff --cached --name-only -z > "$STAGED_FILES"

# Refuse partially staged files: formatting the worktree and re-adding those files
# would otherwise include unrelated unstaged edits in the commit.
if ! node - "$STAGED_FILES" <<'NODE'
const { readFileSync } = require("node:fs");
const { spawnSync } = require("node:child_process");
const paths = readFileSync(process.argv[2]).toString().split("\0").filter(Boolean);
let partial = false;
for (const path of paths) {
  const result = spawnSync("git", ["diff", "--quiet", "--", path]);
  if (result.status === 1) {
    console.error(`Refusing to format partially staged file: ${path}`);
    partial = true;
  } else if (result.status !== 0) {
    process.exit(result.status ?? 1);
  }
}
process.exit(partial ? 1 : 0);
NODE
then
  echo "Stage or stash each file's remaining edits before committing."
  exit 1
fi

node scripts/check-lockfile-commit.mjs
if [ $? -ne 0 ]; then
  exit 1
fi

# Run the check script (formatting, linting, and type checking)
echo "Running formatting, linting, and type checking..."
npm run check
if [ $? -ne 0 ]; then
  echo "❌ Checks failed. Please fix the errors before committing."
  exit 1
fi

RUN_BROWSER_SMOKE=$(node -e '
const { readFileSync } = require("node:fs");
const paths = readFileSync(process.argv[1]).toString().split("\0").filter(Boolean);
console.log(paths.some(path => /^(packages\/(ai|web-ui)\/|package(?:-lock)?\.json$)/.test(path)) ? "1" : "0");
' "$STAGED_FILES")

if [ "$RUN_BROWSER_SMOKE" -eq 1 ]; then
  echo "Running browser smoke check..."
  npm run check:browser-smoke
  if [ $? -ne 0 ]; then
    echo "❌ Browser smoke check failed."
    exit 1
  fi
fi

# Only files that were staged before formatting are returned to the index.
node - "$STAGED_FILES" <<'NODE'
const { readFileSync } = require("node:fs");
const { execFileSync } = require("node:child_process");
const paths = readFileSync(process.argv[2]).toString().split("\0").filter(Boolean);
if (paths.length > 0) execFileSync("git", ["add", "-A", "--", ...paths], { stdio: "inherit" });
NODE

echo "✅ All pre-commit checks passed!"
